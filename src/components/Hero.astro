---
// Hero minimalista — estética editorial luxury
---

<section class="pt-36 pb-16 px-6 text-center bg-ivory-100 overflow-hidden">
  <div class="max-w-2xl mx-auto">

    <!-- Ornamento superior -->
    <div class="flex items-center justify-center gap-3 mb-10" aria-hidden="true">
      <div class="h-px w-20 bg-linear-to-r from-transparent to-gold-400"></div>
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="text-gold-500 shrink-0">
        <path d="M5 0 L6.2 3.8 L10 5 L6.2 6.2 L5 10 L3.8 6.2 L0 5 L3.8 3.8 Z" fill="currentColor"/>
      </svg>
      <div class="h-px w-20 bg-linear-to-l from-transparent to-gold-400"></div>
    </div>

    <!-- Nombre de marca -->
    <h1 class="font-serif text-7xl sm:text-8xl font-light text-stone-900 tracking-[0.4em] uppercase leading-none mb-4">
      Alas
    </h1>

    <!-- Subtítulo -->
    <p class="text-[10px] tracking-[0.6em] uppercase text-gold-600 mb-8 font-sans font-light">
      Joyería Fina
    </p>

    <!-- Tagline -->
    <p class="text-stone-400 text-sm font-light leading-loose max-w-xs mx-auto font-sans">
      Piezas únicas que celebran<br/>la elegancia en su forma más silenciosa
    </p>

    <!-- Ornamento inferior -->
    <div class="flex items-center justify-center gap-3 mt-10" aria-hidden="true">
      <div class="h-px w-20 bg-linear-to-r from-transparent to-gold-300"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-gold-400 shrink-0"></div>
      <div class="h-px w-20 bg-linear-to-l from-transparent to-gold-300"></div>
    </div>

  </div>
</section>
