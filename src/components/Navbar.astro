---
// Navbar — sin props requeridos
---

<header id="main-navbar" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-ivory-100/95 backdrop-blur-md border-b border-ivory-300">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a
      href="/"
      class="font-serif text-xl tracking-[0.35em] text-stone-900 uppercase hover:text-gold-600 transition-colors duration-300"
      aria-label="Alas Joyería — Inicio"
    >
      Alas
    </a>

    <!-- Nav central (desktop) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      <a href="/" class="text-[10px] tracking-[0.22em] uppercase text-stone-500 hover:text-stone-900 transition-colors duration-200">
        Colección
      </a>
      <a href="#sobre-nosotros" class="text-[10px] tracking-[0.22em] uppercase text-stone-500 hover:text-stone-900 transition-colors duration-200">
        Nosotros
      </a>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-3">
      <!-- Botón búsqueda -->
      <button
        id="search-trigger"
        aria-label="Abrir buscador"
        class="p-2 text-stone-500 hover:text-stone-900 transition-colors duration-200 rounded-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </button>

      <!-- Botón menú mobile -->
      <button
        id="mobile-menu-trigger"
        class="md:hidden p-2 text-stone-500 hover:text-stone-900 transition-colors duration-200"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ivory-300 bg-ivory-100" role="navigation">
    <nav class="max-w-7xl mx-auto px-6 py-5 flex flex-col gap-1">
      <a href="/" class="text-[10px] tracking-[0.25em] uppercase text-stone-600 py-3 border-b border-ivory-200 hover:text-stone-900 transition-colors">
        Colección
      </a>
      <a href="#sobre-nosotros" class="text-[10px] tracking-[0.25em] uppercase text-stone-600 py-3 hover:text-stone-900 transition-colors">
        Nosotros
      </a>
    </nav>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const menu    = document.getElementById('mobile-menu');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  let open = false;

  trigger?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    trigger.setAttribute('aria-expanded', String(open));
  });

  // Sombra sutil al hacer scroll
  const navbar = document.getElementById('main-navbar');
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('shadow-sm', window.scrollY > 40);
  }, { passive: true });

  // Abrir modal de búsqueda — se re-enlaza en cada navegación con AbortController
  // para que funcione correctamente con transition:persist + ClientRouter.
  let triggerAbort: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    triggerAbort?.abort();
    triggerAbort = new AbortController();
    document.getElementById('search-trigger')?.addEventListener('click', () => {
      const overlay = document.getElementById('search-overlay');
      overlay?.classList.remove('hidden');
      overlay?.classList.add('flex');
      document.getElementById('search-input')?.focus();
      document.body.style.overflow = 'hidden';
    }, { signal: triggerAbort.signal });
  });
</script>
