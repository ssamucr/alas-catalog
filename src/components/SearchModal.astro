---
// SearchModal — búsqueda instantánea con Fuse.js
// Los datos de productos se inyectan en la página padre con define:vars
---

<!-- Overlay de búsqueda -->
<div
  id="search-overlay"
  class="hidden fixed inset-0 z-50 items-start justify-center pt-20 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Buscador de productos"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm animate-fade-in"></div>

  <!-- Panel de búsqueda -->
  <div class="relative w-full max-w-xl bg-white shadow-2xl animate-scale-in overflow-hidden">

    <!-- Input -->
    <div class="flex items-center gap-3 px-5 py-4 border-b border-ivory-300">
      <svg class="text-stone-400 shrink-0" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Buscar en la colección…"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 text-sm text-stone-800 placeholder-stone-400 bg-transparent outline-none font-sans"
        aria-label="Campo de búsqueda"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button
        id="search-close"
        aria-label="Cerrar buscador"
        class="text-stone-400 hover:text-stone-700 transition-colors p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Resultados -->
    <div
      id="search-results"
      class="max-h-[60vh] overflow-y-auto"
      role="listbox"
      aria-label="Resultados de búsqueda"
    >
      <!-- Estado inicial -->
      <div id="search-hint" class="py-8 text-center">
        <p class="text-xs tracking-[0.2em] uppercase text-stone-400 font-sans">
          Escribe para buscar en la colección
        </p>
      </div>
    </div>

    <!-- Footer del modal -->
    <div class="px-5 py-2.5 border-t border-ivory-200 bg-ivory-50 flex items-center justify-between">
      <span class="text-[9px] tracking-[0.2em] uppercase text-stone-400">Alas Joyería</span>
      <span class="text-[9px] tracking-[0.15em] text-stone-400 font-sans">Esc para cerrar</span>
    </div>

  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  type ProductItem = {
    slug: string;
    title: string;
    description: string;
    category: string;
    price: number;
    image: string;
    inStock: boolean;
  };

  // Los datos se inyectan desde la página padre
  const products: ProductItem[] = (window as any).__ALAS_PRODUCTS__ ?? [];

  const fuse = new Fuse(products, {
    keys: [
      { name: 'title',       weight: 0.6 },
      { name: 'description', weight: 0.25 },
      { name: 'category',    weight: 0.1  },
      { name: 'material',    weight: 0.05 },
    ],
    threshold: 0.35,
    includeScore: true,
    minMatchCharLength: 2,
  });

  // ── Elementos del DOM ─────────────────────────────────
  const overlay   = document.getElementById('search-overlay')!;
  const backdrop  = document.getElementById('search-backdrop')!;
  const input     = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;
  const hintEl    = document.getElementById('search-hint')!;
  const closeBtn  = document.getElementById('search-close')!;

  // ── Formatear precio ──────────────────────────────────
  function formatPrice(price: number) {
    return new Intl.NumberFormat('es-AR', {
      style: 'currency', currency: 'ARS', maximumFractionDigits: 0,
    }).format(price);
  }

  // ── Renderizar resultados ─────────────────────────────
  function renderResults(query: string) {
    if (query.trim().length < 2) {
      resultsEl.innerHTML = '';
      resultsEl.appendChild(hintEl);
      hintEl.style.display = '';
      return;
    }

    const hits = fuse.search(query, { limit: 8 });
    hintEl.style.display = 'none';

    if (hits.length === 0) {
      resultsEl.innerHTML = `
        <div class="py-10 text-center">
          <p class="font-serif text-xl font-light text-stone-400 mb-1">Sin resultados</p>
          <p class="text-xs tracking-widest uppercase text-stone-400">para "${query}"</p>
        </div>`;
      return;
    }

    const listHTML = hits.map(({ item }) => `
      <a
        href="/productos/${item.slug}"
        class="search-result flex items-center gap-4 px-5 py-3.5 hover:bg-ivory-50 transition-colors duration-150 border-b border-ivory-100 last:border-0"
        role="option"
        aria-selected="false"
      >
        <div class="w-12 h-16 flex-shrink-0 overflow-hidden bg-ivory-200">
          <img
            src="${item.image}&w=96"
            alt="${item.title}"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[9px] tracking-[0.22em] uppercase text-stone-400 mb-0.5">${item.category}</p>
          <p class="font-serif text-base font-light text-stone-800 truncate">${item.title}</p>
          <p class="text-xs text-stone-500 font-sans mt-0.5">${formatPrice(item.price)}</p>
        </div>
        ${!item.inStock ? '<span class="text-[8px] tracking-widest uppercase text-stone-400 bg-stone-100 px-2 py-0.5 flex-shrink-0">Agotado</span>' : ''}
        <svg class="text-stone-300 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    `).join('');

    resultsEl.innerHTML = listHTML;
  }

  // ── Cerrar modal ──────────────────────────────────────
  function closeSearch() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
    input.value = '';
    resultsEl.innerHTML = '';
    resultsEl.appendChild(hintEl);
    hintEl.style.display = '';
  }

  // ── Event listeners ───────────────────────────────────
  input.addEventListener('input', (e) => {
    renderResults((e.target as HTMLInputElement).value);
  });

  closeBtn.addEventListener('click', closeSearch);

  backdrop.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
  });

  // Navegar a resultado con Enter o flechas
  resultsEl.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link) closeSearch();
  });
</script>
