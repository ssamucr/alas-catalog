---
interface Props {
  categories: string[];
}
const { categories } = Astro.props;
---

<div
  id="filter-bar"
  class="sticky top-17.25 z-30 bg-ivory-100/95 backdrop-blur-md border-b border-ivory-300"
>
  <div class="max-w-7xl mx-auto px-6 py-3">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">

      <!-- Pills de categoría -->
      <div
        class="flex gap-2 overflow-x-auto no-scrollbar pb-0.5 sm:pb-0"
        role="group"
        aria-label="Filtrar por categoría"
      >
        <button
          data-category="all"
          class="filter-btn shrink-0 text-[10px] tracking-[0.2em] uppercase px-4 py-2 border border-stone-900 bg-stone-900 text-white transition-all duration-200 cursor-pointer"
          aria-pressed="true"
        >
          Todos
        </button>
        {categories.map((cat) => (
          <button
            data-category={cat}
            class="filter-btn shrink-0 text-[10px] tracking-[0.2em] uppercase px-4 py-2 border border-ivory-400 text-stone-500 hover:border-stone-400 hover:text-stone-800 transition-all duration-200 cursor-pointer"
            aria-pressed="false"
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Controles derechos -->
      <div class="flex items-center gap-5 shrink-0">

        <!-- Ordenar -->
        <div class="relative flex items-end gap-1">
          <select
            id="sort-select"
            class="appearance-none text-[10px] tracking-[0.15em] uppercase text-stone-600 bg-transparent border-b border-ivory-400 pb-1 pr-5 cursor-pointer focus:outline-none focus:border-stone-600 transition-colors"
            aria-label="Ordenar productos"
          >
            <option value="">Ordenar</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="az">A — Z</option>
            <option value="za">Z — A</option>
          </select>
          <svg class="absolute right-0 bottom-2 pointer-events-none text-stone-400" width="8" height="8" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
            <path d="M5 8 L1 3 h8 Z"/>
          </svg>
        </div>

        <!-- Toggle solo disponibles -->
        <label class="inline-flex items-center gap-2 cursor-pointer" title="Mostrar solo productos disponibles">
          <input
            type="checkbox"
            id="instock-toggle"
            class="sr-only peer"
            aria-label="Mostrar solo productos disponibles"
          />
          <span
            class="relative inline-block w-9 h-5 rounded-full bg-ivory-400 peer-checked:bg-stone-800 transition-colors duration-200
                   after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full
                   after:bg-white after:shadow-sm after:transition-transform after:duration-200
                   peer-checked:after:translate-x-4"
            aria-hidden="true"
          ></span>
          <span class="text-[10px] tracking-[0.15em] uppercase text-stone-500 hidden sm:inline">
            Disponibles
          </span>
        </label>

      </div>
    </div>
  </div>
</div>
